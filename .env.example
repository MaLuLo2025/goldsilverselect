# YouTube API key — used by the SGI video feed (see the note on SGI below)
SGI_YOUTUBE_API_KEY=

# Resend — lead email
RESEND_API_KEY=
# Optional; both have defaults in src/app/api/lead/route.ts
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# NOTE — no cache credentials are needed.
# /api/prices used to keep its last-good fallback in an Upstash Redis instance
# shared with The Gold Window (both projects pointed at the same one). That was
# replaced by the Vercel Runtime Cache, which is part of the platform: no
# account, no credential, no bill. The old UPSTASH_REDIS_REST_* vars — and the
# _TGW pair, which pointed at that same instance — are gone. Nothing reads them.
#
# NOTE — silvergoldinsights.com moved out of this repo on 2026-08-27, to
# mpm-cloud/silver-gold-insights. public/preview/sgi/ and the SGI host rewrites
# in next.config.js are kept only so the domain can be re-attached here if the
# new stack ever needs rolling back.
